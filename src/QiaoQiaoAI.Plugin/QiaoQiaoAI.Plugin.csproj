<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>QiaoQiaoAI.Plugin</AssemblyName>
    <RootNamespace>QiaoQiaoAI.Plugin</RootNamespace>
    <VPetSourceRoot Condition="'$(VPetSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\work\deps\VPet</VPetSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\QiaoQiaoAI.UI\QiaoQiaoAI.UI.csproj" />
    <ProjectReference Include="$(VPetSourceRoot)\VPet-Simulator.Core\VPet-Simulator.Core.csproj" Private="false" />
    <ProjectReference Include="$(VPetSourceRoot)\VPet-Simulator.Windows.Interface\VPet-Simulator.Windows.Interface.csproj" Private="false" />
  </ItemGroup>
</Project>
